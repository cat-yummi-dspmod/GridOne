<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
		<Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
		<OutputType>Library</OutputType>
		<RootNamespace>GridOne</RootNamespace>
		<AssemblyName>GridOne</AssemblyName>
		<TargetFramework>net472</TargetFramework>
		<FileAlignment>512</FileAlignment>
		<Deterministic>true</Deterministic>
		<RestoreAdditionalProjectSources>https://nuget.bepinex.dev/v3/index.json</RestoreAdditionalProjectSources>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<PackageId>GridOne</PackageId>
		<BepInExPluginGuid>dspdev.gridone</BepInExPluginGuid>
		<Description>One wireless power grid per planet.</Description>
		<Version>1.0.0</Version>
		<Authors>cat-yummi</Authors>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
		<DebugType>full</DebugType>
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="BepInEx.Core" Version="5.4.17" />
		<PackageReference Include="BepInEx.PluginInfoProps" Version="1.0.0" />
		<PackageReference Include="UnityEngine.Modules" Version="2022.3.53" IncludeAssets="compile" />
		<PackageReference Include="DysonSphereProgram.GameLibs" Version="*-*" />
	</ItemGroup>
	<PropertyGroup>
		<ProfileDir Condition=" '$(ProfileDir)' == '' ">$(APPDATA)\r2modmanPlus-local\DysonSphereProgram\profiles\Default</ProfileDir>
		<DeployDir Condition=" '$(DeployDir)' == '' ">$(ProfileDir)\BepInEx\plugins\Unknown-$(AssemblyName)</DeployDir>
	</PropertyGroup>
	<Target Name="DeployToProfile" AfterTargets="Build" Condition="Exists('$(ProfileDir)')">
		<ItemGroup>
			<DeployFiles Include="$(TargetPath);manifest.json;README.md" />
			<DeployFiles Include="icon.png" Condition="Exists('icon.png')" />
		</ItemGroup>
		<Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(DeployDir)" Retries="0" ContinueOnError="WarnAndContinue" />
		<Message Importance="high" Text="已部署到 $(DeployDir)" Condition=" '$(MSBuildLastTaskResult)' == 'true' " />
		<Message Importance="high" Text="部署失败：游戏可能正在运行，关闭游戏后重新编译即可" Condition=" '$(MSBuildLastTaskResult)' != 'true' " />
	</Target>
</Project>
